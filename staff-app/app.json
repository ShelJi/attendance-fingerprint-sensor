{
  "expo": {
    "name": "PL attendance",
    "icon": "./assets/pl-icon.png",
    "slug": "attendance-staff",
    "version": "1.0.0",
    "scheme": "attendance-staff",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.attendance.staff",
      "entitlements": {
        "com.apple.developer.networking.wifi-info": true
      }
    },
    "android": {
      "package": "com.attendance.staff",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/pl-adaptive-icon.png",
        "backgroundColor": "#F7F7F7"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PL attendance uses your location only when you submit attendance to verify your workplace."
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-font",
      "expo-notifications",
      "expo-status-bar"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6a776c40-ca46-4054-8dcf-dce9a37c940c"
      }
    },
    "owner": "shelj"
  }
}
