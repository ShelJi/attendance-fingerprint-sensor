{
  "expo": {
    "name": "PL admin",
    "slug": "mobile-app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/pl-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "entitlements": {
        "com.apple.developer.networking.wifi-info": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F7F7",
        "foregroundImage": "./assets/pl-adaptive-icon.png"
      },
      "package": "com.shelj.myapp",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/pl-icon.png"
    },
    "scheme": "attendance",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      "expo-font",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PL admin uses location permission when you capture office coordinates or connected Wi-Fi details for attendance configuration."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "08f807fa-2804-4fe9-ad0f-4e0ed751432e"
      }
    },
    "owner": "shelj"
  }
}
